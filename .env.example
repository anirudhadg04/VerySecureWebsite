# Application
APP_NAME=VerySecureWebsite
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8081
SECRET_KEY=vsw-development-secret-key-change-this-before-production
BASE_URL=http://127.0.0.1:8081

# Database
DATABASE_URL=sqlite:///./verysecurewebsite.db

# Session and cookies
SESSION_COOKIE_NAME=vsw_session
SESSION_MAX_AGE=86400
REMEMBER_ME_MAX_AGE=2592000
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAMESITE=lax

# SMTP
# Example Gmail SMTP configuration.
# Use a Gmail App Password, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=VerySecureWebsite

# Password reset
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=5

# Authentication protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=3

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_DELAY_SECONDS=30